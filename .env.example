# ISL Bridge Environment Variables
# Copy this file to .env.local to customize for your local setup
# NEVER commit your actual API key to version control!

# Google Gemini API key for advanced ISL NLP gloss generation (optional)
# If left empty, the application runs using local ISL grammar heuristics and phrase dictionary.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Gemini Model name (default: gemini-2.5-flash)
VITE_GEMINI_MODEL=gemini-2.5-flash

# Feature Flags (true/false)
VITE_ENABLE_GEMINI=true
VITE_ENABLE_SPEECH_RECOGNITION=true
VITE_ENABLE_SIGN_RECOGNITION=true
VITE_ENABLE_SIGN_OUTPUT=true

# Vision / Landmark settings
VITE_VISION_TARGET_FPS=30
VITE_VISION_CONFIDENCE_THRESHOLD=0.65

# Speech settings
VITE_SPEECH_DEFAULT_LOCALE=en-IN
