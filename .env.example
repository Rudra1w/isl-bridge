# ==============================================================================
# ISL Bridge — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: NEVER commit your actual API keys or secrets to git!
# Both .env and *.local are already added to .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini NLP Configuration (Optional)
# ------------------------------------------------------------------------------
# ISL Bridge is fully functional without Gemini using its built-in local ISL
# grammar heuristic engine and verified phrase dictionary.
#
# Option A: Direct Client API Key (Convenient for local personal testing)
# WARNING: Do NOT use this in public GitHub Pages production builds as the key
# will be visible in client network traffic.
VITE_GEMINI_API_KEY=

# Option B: Secure Backend Proxy URL (Recommended for production deployments)
# Route translation requests through your own proxy server or serverless function
# so your GEMINI_API_KEY remains secret on the server.
# e.g.: /api/translate-gloss or http://localhost:3001/api/translate-gloss
VITE_GEMINI_PROXY_URL=

# Server-side GEMINI_API_KEY (used if running `npm run server` or Vercel serverless)
GEMINI_API_KEY=

# Model selection (default: gemini-2.5-flash)
VITE_GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Proxy server port (if running `npm run server`)
PORT=3001

# ------------------------------------------------------------------------------
# 2. Feature Flags
# ------------------------------------------------------------------------------
VITE_ENABLE_GEMINI=true
VITE_ENABLE_SPEECH_RECOGNITION=true
VITE_ENABLE_SIGN_RECOGNITION=true
VITE_ENABLE_SIGN_OUTPUT=true

# ------------------------------------------------------------------------------
# 3. Vision & Hardware Performance Settings
# ------------------------------------------------------------------------------
# Quality mode: 'high' (30 FPS inference), 'balanced' (15 FPS), 'low' (10 FPS / lightweight)
VITE_PERFORMANCE_MODE=balanced
VITE_VISION_TARGET_FPS=30
VITE_VISION_CONFIDENCE_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 4. Speech Recognition Settings
# ------------------------------------------------------------------------------
# Default Indian English locale
VITE_SPEECH_DEFAULT_LOCALE=en-IN

# ------------------------------------------------------------------------------
# 5. Deployment Base Path
# ------------------------------------------------------------------------------
# Default './' allows serving from any sub-path (e.g. GitHub Pages https://<user>.github.io/<repo>/)
VITE_BASE_PATH=./
